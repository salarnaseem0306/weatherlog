# Copy this file to .env and adjust. Never commit .env.
# Turn on for local development (shows error pages, serves static files).
DJANGO_DEBUG=True
# Leave empty for a random key at startup, or paste your own. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# Comma-separated hosts the site may be served from.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
